# Local Homebrew Postgres (default after brew install postgresql@16)
# Docker alternative: postgresql://alphabee:alphabee@localhost:5432/alphabee?schema=public
DATABASE_URL="postgresql://localhost:5432/alphabee?schema=public"

# JWT for parent auth
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN="*"
